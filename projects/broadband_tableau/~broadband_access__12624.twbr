      <aliases enabled='yes' />
      <column caption='18 Or Over' datatype='real' name='[18_or_over]' role='measure' type='quantitative' />
      <column caption='65 Or Over' datatype='real' name='[65_or_over]' role='measure' type='quantitative' />
      <column datatype='string' name='[:Measure Names]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;[federated.00t8zqt089u64312rubjw08w1loi].[usr:Calculation_888335077474807810:qk]&quot;' value='Adoption %' />
        </aliases>
      </column>
      <column caption='Statewide Unserved Share' datatype='real' name='[Calculation_888335077468147712]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([unserved_hh_25_3]) / SUM([all_hh])' />
      </column>
      <column caption='Broadband Adoption Rate' datatype='real' name='[Calculation_888335077474807810]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([consumer_connections])/SUM([households_offered])) * 100' />
      </column>
      <column caption='High Gap County' datatype='integer' name='[Calculation_888335077476700163]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF SUM([adoption_gap]) &gt; WINDOW_MEDIAN(SUM([adoption_gap]))&#13;&#10;THEN 1 ELSE 0 END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Median Adoption Gap' datatype='real' name='[Calculation_888335077481287685]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='WINDOW_MEDIAN(SUM([adoption_gap]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Median Poverty' datatype='real' name='[Calculation_888335077481459718]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='WINDOW_MEDIAN(AVG([poverty_pct]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='High Gap Low Poverty' datatype='integer' name='[Calculation_888335077481590791]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='IF SUM([adoption_gap]) &gt; WINDOW_MEDIAN(SUM([adoption_gap]))&#13;&#10;   AND AVG([poverty_pct]) &lt; WINDOW_MEDIAN(AVG([poverty_pct]))&#13;&#10;THEN 1 ELSE 0 END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Below Average Adoption Rate' datatype='boolean' name='[Calculation_888335077819699208]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [adoption_rate] &lt; AVG(SUM([adoption_rate])) THEN 1 ELSE 0 END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Geo Id' datatype='string' name='[GEO_ID]' role='dimension' semantic-role='' type='nominal' />
